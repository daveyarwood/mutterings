#!/usr/bin/env bash

set -eo pipefail

for cmd in sox soxi; do
  if ! which $cmd >/dev/null; then
    echo "$cmd must be available on your PATH." >/dev/stderr
    exit 1
  fi
done

if [[ $# -ne 2 ]]; then
  echo "Usage: $0 AUDIO_FILES_DIR OUTPUT_FILE" >/dev/stderr
  exit 1
fi

audio_dir="$1"
output_file="$2"

total_length_ms=60000
muttering_length_ms=2000

current_length_ms=0

parts_dir="$(mktemp -d)"

seq_number=1

echo "Taking excerpts of audio files:"
while [[ "$current_length_ms" -lt "$total_length_ms" ]]; do
  echo -n '.'
  audio_file="$(find "$audio_dir" -type f | shuf -n1)"
  file_length_ms="$(soxi -D "$audio_file" | awk '{printf "%d\n", $1 * 1000}')"
  offset_ms="$(awk -v max="$file_length_ms" -v seed="$RANDOM" \
    'BEGIN { srand(seed); printf "%d\n", int(rand() * max) }')"

  part_file="$(printf "$parts_dir/part-%03d.wav" "$seq_number")"

  sox \
    "$audio_file" \
    "$part_file" \
    trim \
    "$(awk -v ms="$offset_ms" 'BEGIN { printf "%.3f\n", ms / 1000 }')" \
    "$(awk -v ms="$muttering_length_ms" 'BEGIN { printf "%.3f\n", ms / 1000 }')"

  _=$((current_length_ms+=muttering_length_ms))
  _=$((seq_number++))
done

echo
echo "Stitching them together..."

# Now we need to make all of the parts uniform (both in terms of the sample rate
# and the number of channels) before we stitch them together. We'll do that in
# this new directory.
resampled_parts_dir="$(mktemp -d)"

shopt -s nullglob

for f in "$parts_dir"/*.wav; do
  sox "$f" -r 48000 -c 2 "$resampled_parts_dir/$(basename "$f")"
done

resampled_parts=("$resampled_parts_dir"/*.wav)

sox "${resampled_parts[@]}" "$output_file"

echo "Output: $output_file"
